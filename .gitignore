# --- Python 字节码 ---
__pycache__/
*.pyc
*.pyo

# --- 虚拟环境 ---
.venv/
.venv*/
venv/

# --- 运行时数据 ---
data/

# --- 本地配置（含敏感信息，仅 example 入库） ---
# 匹配任何 *.local.yml；*.example 文件不受影响，仍正常入库
config/*.local.yml

# --- 环境变量 ---
.env
.env.*
!.env.example

# --- IDE / 编辑器 ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 系统文件 ---
.DS_Store
Thumbs.db

# --- 测试 ---
.pytest_cache/

# --- Python 打包 ---
*.egg-info/
dist/
build/

# --- 覆盖率 / 静态检查产物 ---
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.uv-cache/

# --- 日志（本机/容器调试重定向） ---
logs/
*.log

# --- Notebook 检查点 ---
.ipynb_checkpoints/

# --- Claude Code 本地设置（跨机器不同步，团队共享的 CLAUDE.md 仍入库） ---
.claude/settings.local.json
